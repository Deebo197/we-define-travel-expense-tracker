{
  "name": "BankTransaction",
  "properties": {
    "account_source": {
      "enum": [
        "Barclays",
        "Amex"
      ],
      "title": "Account Source",
      "type": "string"
    },
    "amount": {
      "title": "Amount",
      "type": "number"
    },
    "auto_processed": {
      "default": false,
      "title": "Auto Processed",
      "type": "boolean"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "linked_expense_id": {
      "title": "Linked Expense ID",
      "type": "string"
    },
    "receipt_name": {
      "title": "Attached Receipt Filename",
      "type": "string"
    },
    "receipt_url": {
      "title": "Attached Receipt URL",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "allocated",
        "expense_submitted",
        "ignored",
        "payment"
      ],
      "title": "Status",
      "type": "string"
    },
    "transaction_date": {
      "format": "date",
      "title": "Transaction Date",
      "type": "string"
    }
  },
  "required": [
    "account_source",
    "transaction_date",
    "description",
    "amount"
  ],
  "type": "object"
}