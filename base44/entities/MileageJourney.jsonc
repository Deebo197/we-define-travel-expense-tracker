{
  "name": "MileageJourney",
  "properties": {
    "billing_date": {
      "format": "date",
      "title": "Billing Date",
      "type": "string"
    },
    "category": {
      "title": "Category",
      "type": "string"
    },
    "client_allocations": {
      "items": {
        "properties": {
          "amount": {
            "type": "number"
          },
          "client_code": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "percentage": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "title": "Client Allocations",
      "type": "array"
    },
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "drive_sync_failed": {
      "default": false,
      "title": "Drive Sync Failed",
      "type": "boolean"
    },
    "month": {
      "title": "Month",
      "type": "string"
    },
    "purpose": {
      "title": "Purpose",
      "type": "string"
    },
    "rate_per_mile": {
      "title": "Rate Per Mile",
      "type": "number"
    },
    "receipt_code": {
      "title": "Receipt Code",
      "type": "string"
    },
    "receipt_file": {
      "title": "Receipt File",
      "type": "string"
    },
    "receipt_url": {
      "title": "Receipt URL",
      "type": "string"
    },
    "reimbursement_paid": {
      "default": false,
      "title": "Reimbursement Paid",
      "type": "boolean"
    },
    "reimbursement_required": {
      "default": false,
      "title": "Reimbursement Required",
      "type": "boolean"
    },
    "return_journey": {
      "default": false,
      "title": "Return Journey",
      "type": "boolean"
    },
    "route_image_code": {
      "title": "Route Image Code",
      "type": "string"
    },
    "route_image_url": {
      "title": "Route Image URL",
      "type": "string"
    },
    "staff_member": {
      "title": "Staff Member Email",
      "type": "string"
    },
    "staff_member_name": {
      "title": "Staff Member Name",
      "type": "string"
    },
    "stops": {
      "items": {
        "properties": {
          "label": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "title": "Stops",
      "type": "array"
    },
    "total_cost": {
      "title": "Total Cost",
      "type": "number"
    },
    "total_miles": {
      "title": "Total Miles",
      "type": "number"
    },
    "vehicle_type": {
      "enum": [
        "Car",
        "Motorcycle",
        "Bicycle"
      ],
      "title": "Vehicle Type",
      "type": "string"
    },
    "year": {
      "title": "Year",
      "type": "number"
    }
  },
  "required": [
    "date",
    "vehicle_type",
    "purpose",
    "stops",
    "client_allocations",
    "staff_member"
  ],
  "rls": {
    "create": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.staff_member": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.staff_member": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}